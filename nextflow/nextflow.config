
profiles {
    slurm {
        includeConfig 'config/alpine-slurm.conf'
    }
}
params {
    // files and configuration settings needed ahead of time
    metadata_tsv      = "metadata.tsv"
    fastq_dir         = "Fastq" // if demultiplexed by sequencing core
    // READ FORMAT (FOR IMPORT)
    read_type         = 'SampleData[PairedEndSequencesWithQuality]' // see (url) for options
    read_format       = 'CasavaOneEightSingleLanePerSampleDirFmt'   // see (url) for options


    // GENERATED, saved (publishDir), and prereq for other processes (often)
    // PHASE I
    // use fastp outside of the qiime2 trajectory to see what its autodetect
    // trim lengths are
    

    // saved to results/demux
    demux_qza         = "demux.qza" 
    demux_summary_qzv         = "demux_summary.qzv"

    // PHASE II
    // TRUNCATION PARAMETERS
    // Determine these from the demux_summary.qzv quality plots:
    //   1. Open demux_summary.qzv at https://view.qiime2.org
    //   2. Go to the Interactive Quality Plot tab
    //   3. For each direction (forward/reverse), find the position where:
    //      - Median quality drops below ~30, OR
    //      - The box (interquartile range) drops below ~25
    //   4. Set trunc-len to that position (or slightly before)
    //   5. Verify sufficient overlap for merging:
    //      trunc_len_f + trunc_len_r - amplicon_length > 20 bp
    //      (V4 515F/806R amplicon ≈ 253 bp)
    //   6. After denoising, check dada2_denoise_stats.qzv:
    //      - "percentage of input merged" should be >70%
    //      - "percentage of input non-chimeric" should be >70%
    trunc_len_f = 220
    trunc_len_r = 230
    trim_left_f = 0   // set >0 if primers are still present
    trim_left_r = 0
    // generated by denoise
    dada2_table       = "dada2_feature_table.qza"
    dada2_rep_seqs    = "dada2_rep_seqs.qza"
    dada2_base_trans_stats = "dada2_base_transition_stats.qza"
    dada2_stats       = "dada2_denoise_stats.qza"
    // feature-table filter-*
    filtered_table    = "filtered_feature_table.qza"
    // generated by taxonomy
    taxonomy          = "sklearn_taxonomy.qza"
    rooted_tree       = "mafft_fasttree_rooted_tree.qza"
    collapsed_table   = "collapsed_l6_table.qza"
    taxa_barplot      = "taxa_barplot.qzv"

    // RESULTS (publishDirs)
    /*
    results/
      denoise/       # import, demux summary, DADA2 outputs
      taxonomy/      # classification, barplots, collapsed tables
      diversity/     # core metrics, PCoA, alpha rarefaction
    */
    results_fastp     = "${projectDir}/results/fastp"
    results_demux     = "${projectDir}/results/demux"
    results_denoise   = "${projectDir}/results/denoise"
    results_features  = "${projectDir}/results/features"
    results_taxonomy  = "${projectDir}/results/taxonomy"
}
report {
    enabled = true
    overwrite = false
    file = "reports/report_${new Date().format('yyyyMMdd_HHmmss')}.html"
}
timeline {
    enabled = true
    overwrite = false
    file = "reports/timeline_${new Date().format('yyyyMMdd_HHmmss')}.html"
}
dag {
    enabled = true
    overwrite = false
    file = "reports/dag_${new Date().format('yyyyMMdd_HHmmss')}.png"
}
trace {
    enabled = true
    overwrite = false
    file = "reports/trace_${new Date().format('yyyyMMdd_HHmmss')}.txt"
}
